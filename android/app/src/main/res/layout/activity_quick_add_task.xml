<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/widget_todo_card_bg"
    android:padding="20dp"
    android:layout_margin="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="texō"
                android:textColor="#213A50"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/quick_add_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add to Checklist"
                android:textColor="#1C2B36"
                android:textSize="17sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_quick_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@null"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="#8AA0B4"
            android:contentDescription="Close" />
    </LinearLayout>

    <!-- Task Input Box -->
    <EditText
        android:id="@+id/edit_quick_task"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/widget_input_bg"
        android:padding="12dp"
        android:hint="Type a task and press Enter..."
        android:textColor="#1C2B36"
        android:textColorHint="#8AA0B4"
        android:textSize="15sp"
        android:inputType="textCapSentences|textAutoCorrect"
        android:imeOptions="actionDone"
        android:maxLines="4" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_quick_cancel"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="Cancel"
            android:textColor="#5A6E82"
            android:textSize="13sp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_quick_add"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/widget_btn_action_bg"
            android:text="Add Task"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingStart="18dp"
            android:paddingEnd="18dp" />
    </LinearLayout>

</LinearLayout>
