<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_quick_note_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_quick_note_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <ImageView
        android:id="@+id/widget_quick_note_icon"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/widget_circle_button"
        android:padding="10dp"
        android:src="@android:drawable/ic_input_add"
        android:tint="#FFFFFF"
        android:contentDescription="New Note" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="New Note"
        android:textColor="#1C2B36"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>

